{
  "manifest_version": 3,
  "name": "SDGun Forum Web Access",
  "version": "1.0.5",
  "description": "Browse the SDGun forum (Discuz touch version) from a desktop browser: presents a mobile User-Agent for requests to *.sdgun.com.cn.",
  "author": "deserthouse",
  "homepage_url": "https://github.com/deserthouse/sdgun-web-access",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "*://*.sdgun.com.cn/*",
    "*://*.sdgun.net/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ua_rules",
        "enabled": true,
        "path": "rules/ua.json"
      }
    ]
  },
  "action": {
    "default_title": "SDGun Forum Web Access",
    "default_popup": "popup.html"
  }
}
