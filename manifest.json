{
  "manifest_version": 3,
  "name": "SDGun Forum Web Access",
  "version": "1.14.0",
  "description": "Browse the SDGun forum (Discuz touch version) from a desktop browser: presents a mobile User-Agent for requests to *.sdgun.com.cn and applies a modern reading theme (wide layout, dark mode, image lightbox).",
  "author": "deserthouse",
  "homepage_url": "https://github.com/deserthouse/sdgun-extension",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.sdgun.com.cn/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ua_rules",
        "enabled": true,
        "path": "rules/ua.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://bbs.sdgun.com.cn/*"
      ],
      "js": [
        "content/navguard.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://bbs.sdgun.com.cn/*"
      ],
      "js": [
        "content/touchemu.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://bbs.sdgun.com.cn/*"
      ],
      "js": [
        "content/selectors.js",
        "content/redraw/base.js",
        "content/redraw/viewthread.js",
        "content/redraw/forumdisplay.js",
        "content/redraw/forumlist.js",
        "content/redraw/sidebar.js",
        "content/redraw/rightrail.js",
        "content/boot.js"
      ],
      "css": [
        "content/theme.css"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "SDGun Forum Web Access",
    "default_popup": "popup.html"
  }
}